# Secrets — never commit
.env

# Virtual environments
.venv/
venv/
env/

# Python bytecode / caches
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# Generated during ingestion; regenerate with ingest/run_ingestion.py
# Pattern is data/raw/* (not data/raw/) so the .gitkeep can be re-included:
# git cannot re-include a file whose parent directory is excluded.
data/raw/*
!data/raw/.gitkeep

# ChromaDB vector store. Regenerate with ingest/run_ingestion.py; the binary
# blobs are large and derived from data/raw/. Pattern is data/chroma/* (not
# data/chroma/) so the .gitkeep can be re-included.
# NOTE: with this ignored, a Render deploy must run ingestion at build/startup
# time, since the free tier has an ephemeral filesystem.
# See Docs/architecture.md section 4.
data/chroma/*
!data/chroma/.gitkeep

# Cached model responses, keyed by the SHA-256 of the request. Ignored because
# it is an optimisation for a rate-limited provider, not a source of truth:
# llm_cache is keyed on the full request, so a hit is only ever a repeat of a
# call already made, and deleting this directory changes nothing but speed and
# token spend.
data/llm_cache/

# Local tool state
.streamlit/secrets.toml
.DS_Store
Thumbs.db
