# Secrets — never commit
.env

# Virtual environments
.venv/
venv/
env/

# Python bytecode / caches
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# Generated during ingestion; regenerate with ingest/run_ingestion.py
# Pattern is data/raw/* (not data/raw/) so the .gitkeep can be re-included:
# git cannot re-include a file whose parent directory is excluded.
data/raw/*
!data/raw/.gitkeep

# NOTE: data/chroma/ is deliberately NOT ignored.
# Render's free tier has an ephemeral filesystem, so the store cannot be
# rebuilt at request time and cannot survive a spin-down unless it is in git.
# Rebuilding it in the build command was tried and reverted: ingestion depends
# on live third-party pages and on ~800 MB for the embedding model, so a flaky
# sbimf.com page or a 512 MB instance turns a deploy into a red build, and the
# first wake-up still has nothing. 21 MiB of churn is the cheaper trade.
# See Docs/architecture.md section 4.

# Cached model responses, keyed by the SHA-256 of the request. Ignored because
# it is an optimisation for a rate-limited provider, not a source of truth:
# llm_cache is keyed on the full request, so a hit is only ever a repeat of a
# call already made, and deleting this directory changes nothing but speed and
# token spend.
data/llm_cache/

# Local tool state
.streamlit/secrets.toml
.DS_Store
Thumbs.db
